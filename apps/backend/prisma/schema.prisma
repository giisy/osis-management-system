// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String       @id @default(uuid())
  name             String
  email            String       @unique
  password         String
  role             Role         @default(ANGGOTA)
  nis              String?      @unique
  kelas            String?
  jenisKelamin     String?
  noTelepon        String?
  alamat           String?
  divisiId         String?
  divisi           Divisi?      @relation("DivisiAnggota", fields: [divisiId], references: [id], onDelete: Restrict)
  agendaDibuat     Agenda[]     @relation("AgendaCreator")
  pengumumanDibuat Pengumuman[] @relation("PengumumanCreator")
  absensi          Absensi[]    @relation("UserAbsensi")
  transaksiDibuat  Transaksi[]  @relation("TransaksiCreator")
  peminjaman       Peminjaman[] @relation("UserPeminjaman")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Divisi {
  id        String   @id @default(uuid())
  nama      String   @unique
  deskripsi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  anggota   User[]   @relation("DivisiAnggota")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  KETUA
  ANGGOTA
}

model Agenda {
  id           String    @id @default(uuid())
  judul        String
  deskripsi    String?
  lokasi       String?
  waktuMulai   DateTime
  waktuSelesai DateTime?
  createdBy    String
  creator      User      @relation("AgendaCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  absensi      Absensi[] @relation("AgendaAbsensi")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Pengumuman {
  id        String   @id @default(uuid())
  judul     String
  isi       String
  createdBy String
  creator   User     @relation("PengumumanCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AbsensiStatus {
  HADIR
  IZIN
  ALFA
}

model Absensi {
  id           String        @id @default(uuid())
  agendaId     String
  agenda       Agenda        @relation("AgendaAbsensi", fields: [agendaId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation("UserAbsensi", fields: [userId], references: [id], onDelete: Restrict)
  status       AbsensiStatus @default(HADIR)
  waktuCheckIn DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([agendaId, userId])
}

enum JenisTransaksi {
  PEMASUKAN
  PENGELUARAN
}

model Transaksi {
  id         String          @id @default(uuid())
  jenis      JenisTransaksi
  jumlah     Int
  keterangan String
  tanggal    DateTime
  createdBy  String
  creator    User            @relation("TransaksiCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

enum KondisiBarang {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
}

enum StatusPeminjaman {
  DIPINJAM
  DIKEMBALIKAN
}

model Barang {
  id         String        @id @default(uuid())
  nama       String        @unique
  deskripsi  String?
  jumlah     Int
  kondisi    KondisiBarang @default(BAIK)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  peminjaman Peminjaman[]  @relation("BarangPeminjaman")
}

model Peminjaman {
  id             String           @id @default(uuid())
  barangId       String
  barang         Barang           @relation("BarangPeminjaman", fields: [barangId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("UserPeminjaman", fields: [userId], references: [id], onDelete: Restrict)
  jumlah         Int
  keperluan      String?
  tanggalPinjam  DateTime
  tanggalKembali DateTime?
  status         StatusPeminjaman @default(DIPINJAM)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}